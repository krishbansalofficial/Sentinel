# AppArmor profile for bubblewrap on kernels that restrict unprivileged user namespaces
# (kernel.apparmor_restrict_unprivileged_userns=1, the Ubuntu 24.04 default).
#
# Without it, the kernel moves bwrap's new user namespace into the `unprivileged_userns`
# profile, which denies the capabilities bwrap needs inside it (for example bringing up
# loopback in the new network namespace), and Sentinel's Linux sandbox fails closed.
# This grants the `userns` permission to bwrap only, instead of turning the restriction
# off for every program on the machine.
#
# Trade-off (read before installing): the restriction exists to shrink the kernel attack
# surface that unprivileged user namespaces expose. Attached to /usr/bin/bwrap, this lets
# EVERY local user reach that surface through bwrap, not only Sentinel. On a shared machine
# prefer a narrower setup: copy bwrap to a root-owned path executable only by a dedicated
# group, e.g.
#   install -o root -g sentinel -m 0750 /usr/bin/bwrap /usr/local/lib/sentinel/bwrap
# change the attachment path below to /usr/local/lib/sentinel/bwrap, and run Sentinel with
# SENTINEL_BWRAP=/usr/local/lib/sentinel/bwrap as a member of that group. Sentinel never
# installs this profile itself; CI uses it on throwaway runners.
#
# Install (as root):
#   install -m 0644 packaging/apparmor/sentinel-bwrap /etc/apparmor.d/sentinel-bwrap
#   apparmor_parser -r /etc/apparmor.d/sentinel-bwrap
# If the distribution's own `bwrap-userns-restrict` profile is loaded, unload it first
# (apparmor_parser -R /etc/apparmor.d/bwrap-userns-restrict): it attaches to the same path.

abi <abi/4.0>,
include <tunables/global>

profile sentinel-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/sentinel-bwrap>
}
