{
  "name": "change-assurance-desktop",
  "version": "0.0.0",
  "description": "Sentinel desktop (renderer + Electron shell)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:localhost:5173 && electron electron/main.cjs --dev\"",
    "electron": "electron electron/main.cjs",
    "api:generate": "node scripts/api/generate.mjs",
    "api:check": "node scripts/api/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test src/lib/api/client.test.ts src/lib/status.test.ts src/lib/lifecycle.test.ts src/lib/known.test.ts src/lib/export.test.ts src/lib/theme.test.ts src/lib/diagnostics.test.ts src/lib/tui.test.ts src/styles/contrast.test.ts src/features/delivery/outcomes.test.ts src/features/recovery/recovery.test.ts src/features/timeline/payload.test.ts src/features/applyback/applyback.test.ts",
    "test:electron": "node --test electron/tests/*.test.cjs",
    "test": "npm run test:unit && npm run test:electron",
    "test:e2e": "playwright test",
    "build": "npm run api:check && npm run typecheck && vite build",
    "package:dir": "npm run build && npm run stage:backend && electron-builder --dir --config electron-builder.yml",
    "stage:backend": "node scripts/packaging/stage-backend.mjs",
    "package:dir:no-backend": "npm run build && electron-builder --dir --config electron-builder.yml --config.extraResources=[]",
    "test:electron:smoke": "node scripts/smoke-electron.mjs"
  },
  "type": "module",
  "private": "true",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.47.0",
    "openapi-typescript": "^7.13.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
