# Desktop app and test artifacts
node_modules/
*.log

# All markdown and plain-text docs kept out of the tracked tree per explicit
# request (2026-09-20): only the root README.md stays visible/tracked. Files
# remain on disk locally; they are just no longer git-tracked. This includes
# .planning/ (GSD workflow state), subdirectory READMEs, and team handoff docs.
*.md
!/README.md
# The active cross-platform plan is a shared, tracked document.
!/HANDOFF.md
!/CONTRIBUTING.md
!/.github/**/*.md
# HANDOFF rule 9: every benchmark documents its command, hardware and raw output.
!/bench/**/*.md
*.txt
/*.pdf
/brag-output/
/image.png

# Local demo work kept out of the tracked tree (2026-09-27). The tracked files
# apps/desktop/{package.json,src/app/router.tsx,src/lib/nav.ts} carry local demo
# edits hidden with `git update-index --skip-worktree` (undo: --no-skip-worktree).
/output/
/apps/desktop/e2e/demo.spec.ts
/apps/desktop/scripts/start-demo.ps1
/apps/desktop/src/features/workspace/DemoPage.tsx

# GSD runtime state (planning docs are local-only; config.json stays tracked)
/.planning/milestone.lock
/.planning/state.json
/.planning/phases/**/.gitkeep
